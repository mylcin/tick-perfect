{
  "name": "tick-perfect",
  "version": "1.0.0",
  "private": true,
  "description": "A one-tap timing game played on a 3D mechanical watch.",
  "keywords": [
    "game",
    "watch",
    "horology",
    "threejs",
    "react-three-fiber"
  ],
  "homepage": "https://tick-perfect.vercel.app",
  "bugs": "https://github.com/mylcin/tick-perfect/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mylcin/tick-perfect.git"
  },
  "license": "MIT",
  "author": "Mustafa Yalçın (https://mylcin.vercel.app)",
  "type": "module",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "size": "node scripts/check-bundle.js",
    "check:api": "node scripts/check-api.js",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/render-icons.js",
    "thumbnails": "node scripts/render-thumbnails.js",
    "og": "node scripts/render-og.js",
    "readme-image": "node scripts/render-readme.js",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:api && npm run test:coverage && npm run build && npm run size"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/auth-js": "^2.117.2",
    "jose": "^6.2.12",
    "postgres": "^3.4.9",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lefthook": "^2.1.15",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
