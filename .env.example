# The online features: sign-in, the leaderboard, rules tuned without a
# deploy. Leave these out and the game is the offline game, with no
# sign-in anywhere. See docs/BACKEND.md for setting a project up.
#
# Copy to .env.local for `npm run dev`; set the same in the Vercel
# project's Environment Variables for a deployment.

# --- Read by the page (public, safe to ship) ---
# The Supabase project's URL and its publishable (anon) key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Who is responsible for the players' data, and how to reach them: shown in
# the privacy notice at /privacy. A build on Vercel, or with an online side,
# refuses to build without them.
VITE_PRIVACY_CONTROLLER=Your Name
VITE_PRIVACY_EMAIL=privacy@example.com

# --- Read by the API only (secret, never prefixed VITE_) ---
# Postgres through Supabase's pooler (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres
# The same project URL, for checking sign-in tokens.
SUPABASE_URL=https://your-project.supabase.co
# Only for a project still on the legacy JWT secret; leave empty to use
# its signing keys.
SUPABASE_JWT_SECRET=
# Lets "Delete my account" delete the sign-in, and the data with it.
# Without it, deleting an account fails (the privacy notice promises both).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: an incoming webhook (Slack, Discord or alike) told when the API
# fails, at most once an hour.
ALERT_WEBHOOK_URL=
